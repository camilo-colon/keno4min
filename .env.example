APP_NAME=keno4min
ENVIRONMENT=development

# The infrastructure repository provides these values in deployed environments.
AWS_REGION=us-east-1
DYNAMODB_TABLE=keno4min-local

# Development and test only. Leave empty to use the AWS DynamoDB endpoint.
DYNAMODB_ENDPOINT=

HTTP_ADDRESS=:8080

# Core service that owns the node balance (debits and credits).
CORE_BASE_URL=http://localhost:8081
CORE_TIMEOUT=5s
