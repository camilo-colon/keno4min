APP_NAME=keno4min
APP_ENV=development

HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s
HTTP_BODY_LIMIT_BYTES=4194304

# Leave empty to disable CORS. Use a comma-separated allowlist in production.
HTTP_ALLOWED_ORIGINS=http://localhost:3000

# Fiber only trusts the proxy header when at least one proxy IP/CIDR is listed.
HTTP_PROXY_HEADER=X-Forwarded-For
HTTP_TRUSTED_PROXIES=
